<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="TraceK 사용자 흐름 부하테스트" enabled="true">
      <stringProp name="TestPlan.comments">사용자 흐름 기반 부하테스트 (병목 발견용). 프론트(origin/develop) 화면별 실제 API 호출 순서를 재현.
사용자 유형 비율: A 둘러보기 30 / B 지도탐색 25 / C 검색 20 / D 방문인증(조회만) 10 / E 랭킹·마이페이지 15.
쓰기는 좋아요/아카이브만, 누른 직후 취소해서 운영 데이터를 원상복구한다. 방문 인증 POST는 보내지 않는다.

성능 목표(기획 Notion '성능 목표'): 평균 140VU / 9.7 RPS / 20분, 피크 560VU / 46.7 RPS / 30분,
p95 &lt;= 300ms, p99 &lt;= 500ms, 에러율 &lt; 1%. 전체 요청량은 Constant Throughput Timer로 TARGET_RPS에 고정한다.

데이터 준비: ./export-flow-data.sh (대상 서버와 같은 DB에서)
실행: ./run-flow-test.sh avg|peak|stress &lt;HOST&gt;
판정: python summarize-flow-result.py &lt;result.jtl&gt;</stringProp>
      <boolProp name="TestPlan.functional_mode">false</boolProp>
      <boolProp name="TestPlan.serialize_threadgroups">true</boolProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments"><collectionProp name="Arguments.arguments"/></elementProp>
    </TestPlan>
    <hashTree>
      <ConfigTestElement guiclass="HttpDefaultsGui" testclass="ConfigTestElement" testname="HTTP 요청 기본값" enabled="true">
        <elementProp name="HTTPsampler.Arguments" elementType="Arguments"><collectionProp name="Arguments.arguments"/></elementProp>
        <stringProp name="HTTPSampler.protocol">${__P(PROTOCOL,http)}</stringProp>
        <stringProp name="HTTPSampler.domain">${__P(HOST,localhost)}</stringProp>
        <stringProp name="HTTPSampler.port">${__P(PORT,8080)}</stringProp>
        <stringProp name="HTTPSampler.contentEncoding">UTF-8</stringProp>
        <stringProp name="HTTPSampler.connect_timeout">5000</stringProp>
        <stringProp name="HTTPSampler.response_timeout">30000</stringProp>
      </ConfigTestElement>
      <hashTree/>
      <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="공통 헤더" enabled="true">
        <collectionProp name="HeaderManager.headers">
          <elementProp name="" elementType="Header"><stringProp name="Header.name">Accept</stringProp><stringProp name="Header.value">application/json</stringProp></elementProp>
        </collectionProp>
      </HeaderManager>
      <hashTree/>
      <SetupThreadGroup guiclass="SetupThreadGroupGui" testclass="SetupThreadGroup" testname="setUp: 데이터 로드" enabled="true">
        <stringProp name="ThreadGroup.on_sample_error">stoptest</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController">
          <boolProp name="LoopController.continue_forever">false</boolProp>
          <stringProp name="LoopController.loops">1</stringProp>
        </elementProp>
        <stringProp name="ThreadGroup.num_threads">1</stringProp>
        <stringProp name="ThreadGroup.ramp_time">1</stringProp>
      </SetupThreadGroup>
      <hashTree>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="setUp_데이터로드" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">
// flow-data/*.csv 를 한 번만 읽어서 모든 스레드가 공유한다 (props).
def dir = props.getProperty('DATA_DIR', 'flow-data')
def base = new File(dir).isAbsolute() ? new File(dir)
        : new File(org.apache.jmeter.services.FileServer.getFileServer().getBaseDir(), dir)
def lines = { String name -&gt; new File(base, name).readLines('UTF-8').collect { it.trim() }.findAll { it } }
props.put('flow.locations', lines('locations.csv').collect { it.split(',') })
props.put('flow.hot', lines('hot_locations.csv').collect { it.split(',') })
props.put('flow.contents', lines('contents.csv'))
props.put('flow.artists', lines('artists.csv'))
props.put('flow.keywords', lines('keywords.csv'))
// 관광지 상세는 TourAPI(개발계정 1일 1000건)를 동기 호출하므로, 호출 대상이 아닌 CURATED 관광지만 조회한다.
props.put('flow.curated', lines('curated_locations.csv'))
SampleResult.setResponseData(&quot;locations=${props.get('flow.locations').size()}, hot=${props.get('flow.hot').size()}, &quot; +
        &quot;contents=${props.get('flow.contents').size()}, artists=${props.get('flow.artists').size()}, &quot; +
        &quot;keywords=${props.get('flow.keywords').size()}, curated=${props.get('flow.curated').size()}&quot;, 'UTF-8')
</stringProp>
        </JSR223Sampler>
        <hashTree/>
      </hashTree>
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="사용자 흐름" enabled="true">
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController">
          <boolProp name="LoopController.continue_forever">false</boolProp>
          <intProp name="LoopController.loops">-1</intProp>
        </elementProp>
        <stringProp name="ThreadGroup.num_threads">${__P(USERS,140)}</stringProp>
        <stringProp name="ThreadGroup.ramp_time">${__P(RAMP,120)}</stringProp>
        <boolProp name="ThreadGroup.scheduler">true</boolProp>
        <stringProp name="ThreadGroup.duration">${__P(DURATION,1200)}</stringProp>
        <stringProp name="ThreadGroup.delay">0</stringProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
      </ThreadGroup>
      <hashTree>
        <ConstantThroughputTimer guiclass="TestBeanGUI" testclass="ConstantThroughputTimer" testname="목표 처리량 고정 (TARGET_RPS, 스레드그룹 전체 공유)" enabled="true">
          <intProp name="calcMode">4</intProp>
          <stringProp name="throughput">${__jexl3(${__P(TARGET_RPS,9.7)} * 60)}</stringProp>
        </ConstantThroughputTimer>
        <hashTree/>
        <OnceOnlyController guiclass="OnceOnlyControllerGui" testclass="OnceOnlyController" testname="세션 시작 (스레드당 1회)" enabled="true"/>
        <hashTree>
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="00_토큰발급" enabled="true">
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments"><collectionProp name="Arguments.arguments"/></elementProp>
          <stringProp name="HTTPSampler.path">/api/test/auth/token/${userId}</stringProp>
          <stringProp name="HTTPSampler.method">POST</stringProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
        </HTTPSamplerProxy>
        <hashTree>
          <UserParameters guiclass="UserParametersGui" testclass="UserParameters" testname="유저 ID = USER_ID_BASE + 스레드 번호" enabled="true">
            <collectionProp name="UserParameters.names"><stringProp name="0">userId</stringProp></collectionProp>
            <collectionProp name="UserParameters.thread_values">
              <collectionProp name="1"><stringProp name="1">${__intSum(${__threadNum},${__P(USER_ID_BASE,0)})}</stringProp></collectionProp>
            </collectionProp>
            <boolProp name="UserParameters.per_iteration">false</boolProp>
          </UserParameters>
          <hashTree/>
          <JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="JWT 추출" enabled="true">
            <stringProp name="JSONPostProcessor.referenceNames">token</stringProp>
            <stringProp name="JSONPostProcessor.jsonPathExprs">$.data</stringProp>
            <stringProp name="JSONPostProcessor.match_numbers">1</stringProp>
            <stringProp name="JSONPostProcessor.defaultValues">TOKEN_NOT_FOUND</stringProp>
          </JSONPostProcessor>
          <hashTree/>
          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="토큰 없으면 스레드 중단" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">
// 토큰 없이 계속 돌면 이후 요청이 전부 403으로 쌓여 에러율이 부풀고 원인이 가려진다.
// 대상 DB에 USER_ID_BASE + 스레드 번호 유저가 없을 때 발생 (로컬은 900001~900600 시드 필요).
if (prev.getResponseCode() != &apos;200&apos; || vars.get(&apos;token&apos;) == &apos;TOKEN_NOT_FOUND&apos;) {
    log.error(&quot;토큰 발급 실패: userId=${vars.get(&apos;userId&apos;)} HTTP ${prev.getResponseCode()} -&gt; 스레드 중단&quot;)
    prev.setSuccessful(false)
    prev.setStopThread(true)
}
</stringProp>
          </JSR223PostProcessor>
          <hashTree/>
        </hashTree></hashTree>
        <GenericController guiclass="LogicControllerGui" testclass="GenericController" testname="인증 필요 구간" enabled="true"/>
        <hashTree>
        <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="인증 헤더" enabled="true">
          <collectionProp name="HeaderManager.headers">
            <elementProp name="" elementType="Header"><stringProp name="Header.name">Authorization</stringProp><stringProp name="Header.value">Bearer ${token}</stringProp></elementProp>
          </collectionProp>
        </HeaderManager>
        <hashTree/>
        <OnceOnlyController guiclass="OnceOnlyControllerGui" testclass="OnceOnlyController" testname="앱 진입 (스레드당 1회)" enabled="true"/>
        <hashTree>
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="00_내정보" enabled="true">
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments"><collectionProp name="Arguments.arguments"/></elementProp>
          <stringProp name="HTTPSampler.path">/api/users/me</stringProp>
          <stringProp name="HTTPSampler.method">GET</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
        </HTTPSamplerProxy>
        <hashTree></hashTree></hashTree>
        <TestAction guiclass="TestActionGui" testclass="TestAction" testname="사용자 유형/데이터 선택" enabled="true">
          <intProp name="ActionProcessor.action">1</intProp>
          <intProp name="ActionProcessor.target">0</intProp>
          <stringProp name="ActionProcessor.duration">0</stringProp>
        </TestAction>
        <hashTree>
          <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="이번 세션 설정" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">
// 반복(= 사용자 한 명의 방문 세션)마다 유형과 대상 데이터를 새로 고른다.
def rnd = java.util.concurrent.ThreadLocalRandom.current()
def pick = { list -&gt; list[rnd.nextInt(list.size())] }

// 20%는 인기 관광지로 쏠리게 (실제 트래픽의 핫스팟 재현)
def loc = rnd.nextDouble() &lt; 0.2 ? pick(props.get('flow.hot')) : pick(props.get('flow.locations'))
vars.put('locationId', loc[0]); vars.put('locLat', loc[1]); vars.put('locLng', loc[2])
vars.put('contentId', pick(props.get('flow.contents')))
vars.put('artistId', pick(props.get('flow.artists')))
vars.put('keyword', java.net.URLEncoder.encode(pick(props.get('flow.keywords')), 'UTF-8'))
vars.put('homeCategory', pick(['KPOP', 'DRAMA', 'MOVIE', 'ENTERTAINMENT', 'WEBTOON', 'ETC']))
// 관광지 상세 조회 대상: TourAPI를 호출하지 않는 CURATED 관광지 (좋아요/아카이브는 원래 고른 관광지 그대로)
vars.put('detailLocId', pick(props.get('flow.curated')))

// 사용자 유형 비율: A 30 / B 25 / C 20 / D 10 / E 15
def r = rnd.nextDouble() * 100
vars.put('persona', r &lt; 30 ? 'A_둘러보기' : r &lt; 55 ? 'B_지도탐색' : r &lt; 75 ? 'C_검색' : r &lt; 85 ? 'D_방문인증' : 'E_랭킹마이')

// A: 관광지 상세에서 30% 확률로 좋아요 또는 아카이브 (누른 직후 취소해서 운영 데이터 원상복구)
def w = rnd.nextDouble()
vars.put('writeAction', w &lt; 0.15 ? 'like' : w &lt; 0.30 ? 'archive' : 'none')

// B: 지도 조작 횟수(2~4)와 검색 여부, 지도 초기 상태 (프론트 Map.jsx 기본값: 부산시청, level 6)
vars.put('mapActions', String.valueOf(rnd.nextInt(2, 5)))
vars.put('mapSearch', rnd.nextBoolean() ? 'Y' : 'N')
vars.put('mapLat', '35.1795543'); vars.put('mapLng', '129.0756416')
vars.put('mapLevel', '6'); vars.put('mapCategory', '')
</stringProp>
          </JSR223PreProcessor>
          <hashTree/></hashTree>
        <SwitchController guiclass="SwitchControllerGui" testclass="SwitchController" testname="사용자 유형별 흐름" enabled="true">
          <stringProp name="SwitchController.value">${persona}</stringProp>
        </SwitchController>
