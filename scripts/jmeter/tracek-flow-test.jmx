        <GenericController guiclass="LogicControllerGui" testclass="GenericController" testname="B_지도탐색" enabled="true"/>
        <hashTree>
        <TestAction guiclass="TestActionGui" testclass="TestAction" testname="지도 초기 범위 계산" enabled="true">
