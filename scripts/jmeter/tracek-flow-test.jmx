          <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="범위초과 분리" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">
// 너무 넓게 축소하면 서버가 400(LOC008)을 준다. 프론트는 이걸 콘솔 에러로만 처리하므로
// 실패가 아니라 별도 라벨로 집계한다.
def code = prev.getResponseCode()
if (code == '400' &amp;&amp; prev.getResponseDataAsString().contains('LOC008')) {
    prev.setSampleLabel(prev.getSampleLabel() + '_범위초과')
    prev.setSuccessful(true)
} else if (code != '200') {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage('HTTP ' + code)
}
</stringProp>
          </JSR223Assertion>
          <hashTree/></hashTree>
