          <stringProp name="HTTPSampler.path">/api/visit-verifications/location-candidates?latitude=${locLat}&amp;longitude=${locLng}</stringProp>
          <stringProp name="HTTPSampler.method">GET</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
