        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="B_지도_bounds_이동" enabled="true">
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments"><collectionProp name="Arguments.arguments"/></elementProp>
          <stringProp name="HTTPSampler.path">/api/locations/bounds?${boundsQuery}</stringProp>
          <stringProp name="HTTPSampler.method">GET</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
        </HTTPSamplerProxy>
        <hashTree>
          <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="드래그/줌/카테고리 중 하나" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">
// 지도 조작 한 번: 드래그 60% / 확대·축소 25% / 카테고리 칩 토글 15%.
// 프론트는 조작이 끝날 때마다(idle 이벤트) debounce 없이 /bounds를 1번 호출한다.
def rnd = java.util.concurrent.ThreadLocalRandom.current()
double lat = vars.get('mapLat') as double
double lng = vars.get('mapLng') as double
int level = vars.get('mapLevel') as int
double latSpan = 0.016 * Math.pow(2, level - 4)
double lngSpan = 0.011 * Math.pow(2, level - 4)
def a = rnd.nextDouble()
if (a &lt; 0.60) {
    lat += (rnd.nextDouble() * 1.4 - 0.7) * latSpan
    lng += (rnd.nextDouble() * 1.4 - 0.7) * lngSpan
    lat = Math.max(34.95, Math.min(35.40, lat))
    lng = Math.max(128.80, Math.min(129.30, lng))
    vars.put('mapOp', 'drag')
} else if (a &lt; 0.85) {
    level = Math.max(3, Math.min(9, level + (rnd.nextBoolean() ? 1 : -1)))
    vars.put('mapOp', 'zoom')
} else {
    def cats = ['ATTRACTION', 'CULTURE', 'FESTIVAL', 'FILMING_LOCATION', 'RESTAURANT', 'CAFE', 'ACCOMMODATION', 'SHOPPING', 'ETC']
    vars.put('mapCategory', vars.get('mapCategory') ? '' : cats[rnd.nextInt(cats.size())])
    vars.put('mapOp', 'category')
}
vars.put('mapLat', String.valueOf(lat)); vars.put('mapLng', String.valueOf(lng)); vars.put('mapLevel', String.valueOf(level))

double lat = vars.get('mapLat') as double
double lng = vars.get('mapLng') as double
int level = vars.get('mapLevel') as int
double latSpan = 0.016 * Math.pow(2, level - 4)
double lngSpan = 0.011 * Math.pow(2, level - 4)
def q = String.format(java.util.Locale.ROOT,
        'southwestLatitude=%.7f&amp;southwestLongitude=%.7f&amp;northeastLatitude=%.7f&amp;northeastLongitude=%.7f&amp;archivedOnly=false',
        lat - latSpan / 2, lng - lngSpan / 2, lat + latSpan / 2, lng + lngSpan / 2)
def cat = vars.get('mapCategory')
vars.put('boundsQuery', cat ? q + '&amp;category=' + cat : q)
</stringProp>
          </JSR223PreProcessor>
