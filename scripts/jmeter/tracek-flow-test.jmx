            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">
// 방문 인증 모달: 현재 위치 주변 아주 좁은 범위만 조회 (VerifyModal.jsx: ±0.0009 / ±0.0011)
double lat = vars.get('locLat') as double
double lng = vars.get('locLng') as double
vars.put('verifyBoundsQuery', String.format(java.util.Locale.ROOT,
        'southwestLatitude=%.7f&amp;southwestLongitude=%.7f&amp;northeastLatitude=%.7f&amp;northeastLongitude=%.7f&amp;archivedOnly=false',
        lat - 0.0009, lng - 0.0011, lat + 0.0009, lng + 0.0011))
</stringProp>
