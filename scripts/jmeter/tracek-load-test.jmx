          <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="JWT 추출 확인 (TOKEN_NOT_FOUND 방지)" enabled="true">
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="script">def jwt = vars.get("jwt")
if (jwt == null || jwt.isEmpty() || jwt == "TOKEN_NOT_FOUND") {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage("JWT 추출 실패: " + jwt)
}</stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
          </JSR223Assertion>
